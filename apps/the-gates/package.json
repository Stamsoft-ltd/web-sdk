{
	"name": "the-gates",
	"version": "0.0.0",
	"private": true,
	"license": "MIT",
	"scripts": {
		"dev": "vite dev --host --port 3020",
		"dev:https": "GATES_HTTPS=1 vite dev --host localhost --port 3020 --strictPort",
		"build": "vite build && node --experimental-strip-types tools/package-assets.mjs --execute && node --experimental-strip-types tools/optimize-build-assets.mjs",
		"build:full": "vite build",
		"audit:bundle": "node --experimental-strip-types tools/package-assets.mjs",
		"preview": "vite preview",
		"verify:assets": "node tools/verify-figma-assets.mjs",
		"build:motion": "node --experimental-strip-types tools/build-figma-motion.mjs && node tools/build-figma-motion-preview.mjs",
		"test": "node --experimental-strip-types --test tests/*.test.mjs",
		"audit:assets": "node --experimental-strip-types tools/clean-assets.mjs",
		"optimize:build-assets": "node --experimental-strip-types tools/optimize-build-assets.mjs"
	},
	"type": "module",
	"devDependencies": {
		"config-ts": "workspace:*",
		"config-vite": "workspace:*",
		"config-svelte": "workspace:*",
		"config-lingui": "workspace:*",
		"@sveltejs/vite-plugin-svelte": "5.0.3"
	},
	"dependencies": {
		"@esotericsoftware/spine-core": "4.2.74",
		"svelte": "5.20.5",
		"vite": "6.2.0",
		"@sveltejs/kit": "2.17.3",
		"@lingui/core": "5.2.0",
		"rgs-requests": "workspace:*",
		"state-shared": "workspace:*",
		"constants-shared": "workspace:*",
		"components-shared": "workspace:*",
		"components-ui-html": "workspace:*",
		"utils-shared": "workspace:*",
		"utils-xstate": "workspace:*",
		"utils-bet": "workspace:*",
		"pixi.js": "8.8.1",
		"@esotericsoftware/spine-pixi-v8": "4.2.74"
	}
}
